# VoyageDesk private configuration
# Copy to .env (the Start VoyageDesk.bat file does this automatically).
# Never share or upload your .env file.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Destination photos (Pexels)
PEXELS_API_KEY=

# VoyageDesk cloud accounts/database (Supabase)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# OPTIONAL: Amadeus live flight/hotel adapter. Leave blank if unused.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_ENV=test


# OPTIONAL: Viator tours & experiences destination taxonomy.
# Use sandbox while developing/testing. Production is for live partner traffic.
VIATOR_API_KEY=
VIATOR_ENV=sandbox
VIATOR_LANGUAGE=en-US
